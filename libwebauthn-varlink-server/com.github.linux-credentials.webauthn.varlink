interface com.github.linux-credentials.webauthn

#  What an [`Event`] reports.
type EventKind (
	#  Waiting for the user to scan the QR code or confirm on the device.
	ProximityCheck,
	Connecting,
	Authenticating,
	#  The channel is connected. Ends `AwaitConnecting`.
	Connected,
	#  The user must touch or otherwise confirm on the authenticator.
	PresenceRequired,
	#  User verification failed and may be retried. See `retry`.
	Retry,
	#  Answer with `ProvidePin`. See `pin_required` and `pin_token`.
	PinRequired,
	#  The authenticator needs a PIN to be set first. Answer with
	#  `ProvidePin`. See `pin_not_set` and `pin_token`.
	PinNotSet,
	#  The ceremony finished. See `response_json`.
	Completed
)

#  Mirrors `libwebauthn::webauthn::error::Error` for Varlink clients: a
#  ceremony can fail due to a CTAP-level error, a platform-level error, or
#  the underlying transport.
# 
#  Like [`VarlinkTransportError`], this is modeled as a struct (not a
#  data-carrying enum) because `introspect::Type`'s enum derive only
#  supports unit variants. The discriminant lives in `kind`, with
#  `transport` populated only when `kind` is `Transport`.
type CeremonyErrorDetails (kind: CeremonyErrorKind, message: string, #  Populated when `kind` is `Transport`; carries the detailed
#  transport-specific error.
transport: ?TransportErrorDetails)

type CeremonyErrorKind (Ctap, Platform, Transport)

#  Mirrors `libwebauthn::ops::webauthn::MakeCredentialPrepareError` for
#  Varlink clients: a `MakeCredentialRequest::prepare` call can fail because
#  the request JSON was malformed, or because the relying party/AppID didn't
#  validate against the calling origin.
# 
#  Like [`VarlinkTransportError`], this is modeled as a struct (not a
#  data-carrying enum) because `introspect::Type`'s enum derive only
#  supports unit variants. The discriminant lives in `kind`, with the
#  human-readable cause (including any relying party/AppID details) in
#  `message`.
type PrepareErrorDetails (kind: PrepareErrorKind, message: string)

type PrepareErrorKind (
	#  The client must throw an "EncodingError" DOMException.
	EncodingError,
	InvalidRelyingPartyId,
	MismatchingRelyingPartyId,
	#  The client must throw a "SecurityError" DOMException.
	InvalidAppId
)

#  The ceremony a hybrid QR code is generated for. The phone uses it to
#  decide how to present the request.
type Operation (MakeCredential, GetAssertion)

type PinNotSet (reason: PinNotSetReason)

type PinNotSetReason (PinChangeRequired, PinNotSet, PinPolicyViolation, PinTooLong, PinTooShort)

type PinRequestReason (AuthenticatorPolicy, FallbackFromUV, RelyingPartyRequest)

type PinRequired (attempts_left: ?int, reason: PinRequestReason)

#  Plain origin string for a WebAuthn request, as supplied by the client.
type RequestOrigin (origin: string, top_origin: ?string)

type Retry (attempts_left: ?int)

#  Mirrors `libwebauthn::transport::cable::error::CableError` 1:1 for
#  Varlink clients, so they can react to specific caBLE/hybrid transport
#  failures (e.g. distinguishing a `Timeout` from a `ConnectionLost`).
# 
#  Modeled as a struct rather than a data-carrying enum: `introspect::Type`'s
#  enum derive only supports unit variants (Varlink IDL enums are plain
#  string sets), so the discriminant lives in `kind` and the human-readable
#  cause in `message`.
type TransportErrorDetails (kind: TransportErrorKind, message: string)

type TransportErrorKind (
	Noise,
	Io,
	WebSocket,
	Cbor,
	UrlParse,
	UuidParse,
	InvalidHttpHeader,
	CableTunnel,
	ConnectionFailed,
	ConnectionLost,
	InvalidEndpoint,
	InvalidFraming,
	TransportUnavailable,
	Timeout,
	InvalidKey,
	InvalidSignature,
	EncryptionFailed,
	#  Fallback for `CableError` variants added upstream that aren't
	#  explicitly mapped yet (`CableError` is `#[non_exhaustive]`).
	Other
)

#  Which hybrid transport(s) to use/advertise in the QR code.
type TransportMode (
	#  Cloud-assisted WebSocket tunnel only.
	CloudOnly,
	#  Cloud-assisted tunnel plus the direct BLE data channel (CTAP 2.3 hybrid).
	CloudOrBle
)

#  Whether hybrid transport can be used on this system, that is whether a
#  Bluetooth adapter is present.
method IsAvailable() -> (available: bool)

#  Opens a channel for an `operation` ceremony and returns the QR code to
#  show the user. The channel belongs to this connection: an earlier one
#  is replaced, and the other methods act on it.
method FutureDeviceConnection(operation: Operation, transport: TransportMode) -> (qr_contents: string)

#  Streams progress events until the channel is connected, ending with a
#  `Connected` event. On an error, the channel is closed.
method AwaitConnecting() -> (kind: EventKind, #  The token to pass to `ProvidePin`, for
#  `PinRequired` and `PinNotSet`.
pin_token: ?string, pin_required: ?PinRequired, pin_not_set: ?PinNotSet, retry: ?Retry, #  The response in WebAuthn IDL JSON, for `Completed`.
response_json: ?string)

#  Runs a registration ceremony on this connection's channel, streaming
#  progress events and ending with a `Completed` event that carries the
#  response. `request_json` is a WebAuthn IDL `PublicKeyCredentialCreationOptions`,
#  checked against `origin`. The channel is used up, unless the request is
#  invalid.
method WebauthnMakeCredential(origin: RequestOrigin, request_json: string) -> (kind: EventKind, #  The token to pass to `ProvidePin`, for
#  `PinRequired` and `PinNotSet`.
pin_token: ?string, pin_required: ?PinRequired, pin_not_set: ?PinNotSet, retry: ?Retry, #  The response in WebAuthn IDL JSON, for `Completed`.
response_json: ?string)

#  Closes this connection's channel, if it has one.
method CloseChannel() -> ()

#  Answers a `PinRequired` or `PinNotSet` event, identified by its
#  `pin_token`. A null `pin` cancels the ceremony. Call this on a second
#  connection: the one running the ceremony is busy streaming it.
method ProvidePin(token: string, pin: ?string) -> ()

#  The channel closed before it connected.
error PrematureConnectionClose ()

#  This connection has no channel: `FutureDeviceConnection` was never
#  called on it, or the channel was used up or closed.
error NoActiveConnection ()

#  This connection's channel was opened for a different operation than
#  the one requested. The channel stays open.
error OperationMismatch (expected: Operation, actual: Operation)

#  The token passed to `ProvidePin` belongs to no pending PIN request: it
#  is unknown, expired, or already answered.
error UnknownPinRequest ()

error InvalidRequest (message: string)

error CeremonyFailed (message: string)

#  The caBLE/hybrid transport failed. See `TransportErrorDetails` for the
#  specific cause.
error TransportError (error: TransportErrorDetails)

error CeremonyError (error: CeremonyErrorDetails)

error MakeCredentialPrepareError (error: PrepareErrorDetails)

#  Serializing the ceremony's response into WebAuthn IDL JSON failed.
error ResponseSerializationError (message: string)
